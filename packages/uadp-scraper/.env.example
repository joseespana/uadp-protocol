# ─── MongoDB ──────────────────────────────────────────────────────────
# Connection string to the MongoDB instance used for scraped UADP data.
# The scraper writes here; UADP services read from here.
# Uses perseusoft-mongodb-network (external Docker network) so the container
# name of MongoDB resolves. Check your MongoDB docker-compose for the
# service/container name (commonly 'mongodb' or 'mongo').
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=astral_uadp

# ─── Scraper settings ────────────────────────────────────────────────
# How many items to scrape per run (daily cron).
SCRAPE_ARTICLES_MAX=500
SCRAPE_VIDEOS_MAX=100
SCRAPE_PRODUCTS_MAX=20
SCRAPE_POSTS_MAX=200
SCRAPE_TRACKS_MAX=100

# ─── RSS feeds (comma-separated) ────────────────────────────────────
# Technology
RSS_TECH=https://feeds.arstechnica.com/arstechnica/index,https://www.theverge.com/rss/index.xml,https://techcrunch.com/feed/,https://hnrss.org/frontpage,https://www.wired.com/feed/rss,https://www.zdnet.com/news/rss.xml,https://www.engadget.com/rss.xml,https://9to5mac.com/feed/,https://9to5google.com/feed/,https://www.tomshardware.com/feeds/all,https://www.androidcentral.com/feed

# World / Politics / War
RSS_WORLD=https://feeds.bbci.co.uk/news/world/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/World.xml,https://www.aljazeera.com/xml/rss/all.xml,https://feeds.reuters.com/reuters/worldNews,https://www.theguardian.com/world/rss

# Science
RSS_SCIENCE=https://www.nature.com/nature.rss,https://feeds.bbci.co.uk/news/science_and_environment/rss.xml,https://www.newscientist.com/feed/home/,https://phys.org/rss-feed/,https://www.sciencedaily.com/rss/all.xml

# Economy / Finance
RSS_ECONOMY=https://feeds.bloomberg.com/markets/news.rss,https://feeds.bbci.co.uk/news/business/rss.xml,https://www.cnbc.com/id/100003114/device/rss/rss.html,https://rss.nytimes.com/services/xml/rss/nyt/Business.xml,https://www.economist.com/finance-and-economics/rss.xml

# Health
RSS_HEALTH=https://feeds.bbci.co.uk/news/health/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/Health.xml,https://www.statnews.com/feed/,https://medicalxpress.com/rss-feed/

# Travel / Tourism
RSS_TRAVEL=https://www.lonelyplanet.com/news/feed,https://feeds.bbci.co.uk/news/topics/c95yz8vxvy8t/rss.xml,https://www.cntraveler.com/feed/rss,https://www.nomadicmatt.com/travel-blog/feed/,https://feeds.feedburner.com/MatadorNetwork

# Sports
RSS_SPORTS=https://feeds.bbci.co.uk/sport/rss.xml,https://www.espn.com/espn/rss/news,https://www.skysports.com/rss/12040,https://www.marca.com/en/rss/portada.xml

# Entertainment / Culture / Movies
RSS_ENTERTAINMENT=https://feeds.bbci.co.uk/news/entertainment_and_arts/rss.xml,https://www.ign.com/articles/feed,https://www.rollingstone.com/feed/,https://variety.com/feed/,https://deadline.com/feed/

# Lifestyle / Shopping / Consumer reviews (connects to Market service)
RSS_LIFESTYLE=https://www.wired.com/feed/category/gear/latest/rss,https://thewirecutter.com/feed/,https://www.consumerreports.org/feed,https://www.tomsguide.com/feeds/all,https://www.cnet.com/rss/reviews/

# Gaming
RSS_GAMING=https://www.ign.com/articles/feed,https://kotaku.com/rss,https://www.pcgamer.com/rss/,https://www.eurogamer.net/feed

# Videos — two ways (both work, use one or both):
#
# Option A: YouTube channel IDs (direct RSS, no dependencies)
# Format: https://www.youtube.com/feeds/videos.xml?channel_id=CHANNEL_ID
YT_CHANNELS=

# Option B: Search keywords via RSSHub (no channel IDs needed!)
# RSSHub searches YouTube for each keyword and returns recent videos.
# Much easier — just add topics you care about.
# Topics that match what Herald scrapes — so user can read article then watch video
YT_KEYWORDS=tech review 2026,iPhone vs Samsung,best laptop 2026,AI explained,travel vlog,gaming review,product unboxing,world news today,science documentary,fitness routine,movie trailer 2026,cooking recipe,budget travel tips,sports highlights,startup pitch

# Products (optional — Product Hunt RSS)
RSS_PRODUCTS=https://www.producthunt.com/feed

# ─── Twitter/X via RSSHub (self-hosted) ──────────────────────────────
# RSSHub generates RSS feeds from Twitter without API keys.
# Deploy: docker run -d -p 1200:1200 diygod/rsshub
# Docker Compose service name — resolves on the default compose network
RSSHUB_URL=http://rsshub:1200

# Twitter accounts to follow (handles without @, comma-separated)
TWITTER_ACCOUNTS=elaborars,veraborras,TechCrunch,ABORRACHERIA,waborarcheria,BillyM2k,elaborarcheria

# Keywords to track (trending topics, comma-separated)
TWITTER_KEYWORDS=AI,tech,startup,iPhone,Samsung,gaming,travel,breaking news,sports,movies,deals,review

# ─── Music via Last.fm ───────────────────────────────────────────────
# Free API key from: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# ─── Schedule ────────────────────────────────────────────────────────
# Cron expression for the daily scrape job (default: 3am UTC)
SCRAPE_CRON=0 0 * * *
